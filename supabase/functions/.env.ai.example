# Server-side Gemini Developer API configuration for the Locomall listing assistant.
# Copy to .env.ai.local in this directory and fill in the values.
# Upload these selected values as Edge Function secrets; local env alone is not deployed.
# Never use EXPO_PUBLIC_ for these values or import this file into the Expo app.
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_AI_STUDIO_API_KEY
# Copy the exact model ID from AI Studio's Get code panel; use a model with Free Tier support.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
