{
  "expo": {
    "name": "locomall",
    "slug": "locomall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "locomall",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.locomall.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Locomall ใช้ตำแหน่งเพื่อแนะนำตลาดชุมชนใกล้คุณ โดยจะไม่เปิดเผยพิกัดของคุณต่อผู้ใช้อื่น"
      }
    },
    "android": {
      "package": "com.locomall.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF5",
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/APP_LOGO.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF5",
          "dark": {
            "backgroundColor": "#FAFAF5"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#154C2B",
          "defaultChannel": "locomall-updates"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Locomall ใช้ตำแหน่งเพื่อแนะนำตลาดชุมชนใกล้คุณ โดยจะไม่เปิดเผยพิกัดของคุณต่อผู้ใช้อื่น"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec5f6b20-f18a-4c22-9ef3-14e3739caca0"
      }
    },
    "owner": "lnw_mix"
  }
}